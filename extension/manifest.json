{
  "manifest_version": 3,
  "name": "VPN Tab Reaper",
  "version": "1.0.0",
  "description": "Automatically closes AWS VPN Client authentication tabs (127.0.0.1:35001) and restores your focus. No more tab avalanches.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "VPN Tab Reaper",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": ["tabs", "storage", "notifications", "alarms"],
  "commands": {
    "toggle-pause": {
      "suggested_key": {
        "default": "Ctrl+Shift+U",
        "mac": "Command+Shift+U"
      },
      "description": "Pause/unpause VPN Tab Reaper"
    }
  }
}
